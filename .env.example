# ---------------------------------------------------------------------------
# Lemma environment. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Supabase (required) ----------------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (required for /api/explain) ---------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional override; defaults to a cost-effective model.
LEMMA_EXPLAIN_MODEL=claude-haiku-4-5

# --- Web app --------------------------------------------------------------
# Public origin of the web app. Used by the extension auth handoff.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Extension build -----------------------------------------------------
# Base URL the extension calls for the API. Mirrors NEXT_PUBLIC_APP_URL.
# The extension build also reads NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY above
# (baked in for access-token refresh).
LEMMA_API_BASE=http://localhost:3000

# --- Reminder emails (GET /api/remind) --------------------------------
# resend.com -> API Keys. Without it, sendReminderEmail() silently no-ops.
# RESEND_API_KEY=re_...
# Sender identity; must be a verified domain/sender in Resend.
# LEMMA_REMINDER_FROM=Lemma <reminders@yourdomain.com>
# Shared secret the cron caller must send as `Authorization: Bearer $CRON_SECRET`.
# Vercel Cron adds this header automatically when CRON_SECRET is set as a project env var.
# CRON_SECRET=

# --- Follow-up features (not needed for the core loop) ------------------
# OPENAI_API_KEY=sk-...
